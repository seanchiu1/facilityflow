# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is gitignored — never commit your real keys.

# Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Dashboard → Project Settings → API → Project API Keys → anon / public
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ── Playwright E2E suite (npm run test:e2e) — see e2e/README.md ──
# Placeholders only. Set real values in your shell or an untracked
# .env.local — never commit real passwords, even demo ones.
E2E_BASE_URL=https://your-vercel-app.vercel.app
E2E_MANAGER_EMAIL=manager@facilityflow.demo
E2E_MANAGER_PASSWORD=your-manager-password
E2E_VENDOR_EMAIL=vendor@facilityflow.demo
E2E_VENDOR2_EMAIL=vendor2@facilityflow.demo
E2E_VENDOR_PASSWORD=your-vendor-password
E2E_VENDOR2_PASSWORD=your-vendor2-password
